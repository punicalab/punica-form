{
  "name": "@punica/form-mcp",
  "version": "0.4.0-next.0",
  "description": "MCP server for Punica Form: look up the exact API of its packages, read the rules and check code that uses them.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "form",
    "punica"
  ],
  "homepage": "https://form.punicalab.com",
  "bugs": {
    "url": "https://github.com/punicalab/punica-form/issues"
  },
  "repository": {
