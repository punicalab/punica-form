{
  "name": "@punica/form",
  "version": "2.0.0",
  "description": "Headless, framework-agnostic form engine",
  "author": {
    "name": "Uryan Sezgin TEKE",
    "email": "uryan.sezgin.teke@gmail.com",
    "url": "https://github.com/uryansezginteke"
  },
  "keywords": [
    "form",
    "headless",
    "decorators",
    "typescript"
  ],
  "private": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "url": "git+https://github.com/punicalab/punica-form.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup lib/index.ts --format esm,cjs --target es2020 --clean && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf dist",
    "lint": "eslint lib"
  },
  "dependencies": {
    "@punica/util": "^1.0.2"
  }
}
