{
  "name": "@punica/form-service",
  "version": "2.1.0",
  "description": "Built-in services of Punica Form",
  "author": {
    "name": "Uryan Sezgin TEKE",
    "email": "uryan.sezgin.teke@gmail.com",
    "url": "https://github.com/uryansezginteke"
  },
  "keywords": [
    "form",
    "service"
  ],
  "private": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "url": "git+https://github.com/punicalab/punica-form.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup lib/index.ts --format esm,cjs --target es2020 --clean && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf dist",
    "lint": "eslint lib",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@punica/form": "^2.1.0"
  },
  "devDependencies": {
    "@punica/form": "workspace:^"
  }
}
